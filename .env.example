# Copy this file to .env and fill in real values. Never commit .env.
# Tidemark reads all secrets from the environment. Nothing here is logged.

# --- Telegram (read-only alert delivery) ---
# Bot token from @BotFather. Bot needs no permissions beyond sending messages.
# TIDEMARK_TELEGRAM_BOT_TOKEN=

# Chat/channel ID the bot posts alerts to.
# TIDEMARK_TELEGRAM_CHAT_ID=

# --- Market data ---
# Public market-data endpoint override, if ever needed. Tidemark has no
# field for an exchange API key/secret — it uses public data only.
# TIDEMARK_EXCHANGE_BASE_URL=

# --- Storage ---
# SQLAlchemy connection string. Defaults to a local SQLite file if unset.
# TIDEMARK_DATABASE_URL=sqlite:///tidemark.db

# --- Rulebook ---
# Directory containing the versioned rulebook markdown files.
# TIDEMARK_RULEBOOK_DIR=docs/rulebook

# --- Logging ---
# TIDEMARK_LOG_LEVEL=INFO
