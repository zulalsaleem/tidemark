# Copy this file to .env and fill in real values. Never commit .env.
# Tidemark reads all secrets from the environment. Nothing here is logged.

# --- Telegram (read-only alert delivery) ---
# Bot token from @BotFather. Bot needs no permissions beyond sending messages.
# TIDEMARK_TELEGRAM_BOT_TOKEN=

# Chat/channel ID the bot posts alerts to.
# TIDEMARK_TELEGRAM_CHAT_ID=

# --- Market data ---
# Tidemark has no field for an exchange API key/secret — it uses public
# data only. Venue is a ccxt exchange id: binanceusdm, bitget, mexc, ...
# TIDEMARK_VENUE=binanceusdm

# Comma-separated ccxt unified perpetual symbols. The rule for a larger
# universe than the default 5 is NOT_DEFINED — see docs/architecture.md.
# TIDEMARK_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,XRP/USDT:USDT,DOGE/USDT:USDT

# Default backfill depth, in days.
# TIDEMARK_BACKFILL_DAYS=180

# --- Storage ---
# SQLAlchemy connection string. Defaults to a local SQLite file if unset.
# TIDEMARK_DATABASE_URL=sqlite:///tidemark.db

# --- Rulebook ---
# Directory containing the versioned rulebook markdown files.
# TIDEMARK_RULEBOOK_DIR=docs/rulebook

# --- Logging ---
# TIDEMARK_LOG_LEVEL=INFO
